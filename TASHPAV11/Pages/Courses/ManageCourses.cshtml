@page


@using TASHPAV11.Model
@model TASHPAV11.Pages.Courses.ManageCoursesModel
@{   
}
<script src="~/js/Courses.js"></script>
@{
    var sessionAdmin = HttpContext.Session.GetString("Admin");
    var sessionTeacher = HttpContext.Session.GetString("Teacher");
    if (sessionAdmin != "Admin" && sessionTeacher != "Teacher")
    {
        Response.Redirect("/Index");
    }
}


<div class="container my-5">
    <div class="d-flex justify-content-between gap-3">
        <form method="get" asp-page-handler="RenderCourses">
            <button type="submit" value="Show All Courses" class="btn btn-primary">Show All Courses</button>
        </form>
        <form method="post" asp-page-handler="ShowAddCourses">
            <button type="submit" value="Add Course" class="btn btn-primary">Add Course</button>
        </form>
        <form method="post" asp-page-handler="ShowDeleteCourse">
            <button type="submit" value="Delete Course" class="btn btn-primary">Delete Course</button>
        </form>
       
    </div>
</div>

<div id="CourseTable" style="@Model.DisplayList">


    @if (Model.List != null && Model.List.Count > 0)
    {
        <table class='table table-bordered table-striped fw-bold'>
            <tr>
                <th style="width: 10%;"> ID</th>
                <th style="width: 30%;">Course Name</th>
                <th style="width: 20%;">Course Number</th>
                <th style="width: 30%;">Teacher </th>
            </tr>

            @foreach (var course in Model.List)
            {
                <tr>
                    <td>@course.course.CId</td>
                    <td>@course.course.CourseName</td>
                    <td>@course.course.CourseNumber</td>
                    <td>@course.person.Name</td>
                </tr>
            }

        </table>
    }
</div>
<div class="button-container">
    <div class="row">
        @* Add Insert part *@
        <form method="post" asp-page-handler="InsertCourse" onsubmit="return checkInsertValidity()">
            <div id="active_input" style="@Model.active_input">
                <input type="text" id="newCourseName" asp-for="newCourse.course.CourseName" class="input_field notEmpty" placeholder="Course Name" />
                <input type="number" id="newCourseNumber" asp-for="newCourse.course.CourseNumber" class="input_field notEmpty" placeholder="Course Number" />
                <input type="number" id="newCoursePererequisit" asp-for="newCourse.course.Prerequisites_1" class="input_field" placeholder="Pererequisit 1" />
                <input type="number" id="newCourseCredit" asp-for="newCourse.course.Credits" class="input_field" placeholder="Course Credit" />
                <input type="text" id="newCourseTeacher" asp-for="newCourse.person.Name" class="input_field notEmpty" placeholder="Teacher" />
                
                <label for="MathReq">Math Requirement</label>
                <input type="radio" id="MathReq" name="Department" class="input_field" value="MathReq" checked />
                <label for="ComputReq">Computer</label>
                <input type="radio" id="ComputReq" name="Department" class="input_field" value="ComputerReq" />
                <label for="Advance">Advance</label>
                <input type="radio" id="Advance" name="Department" class="input_field" value="Advance" />
               
                <button type="submit" value="Insert" id="submitNewButton" style="@Model.insert_button">
                    Insert
                </button>
                <div style="color: red; font-size: 1.0em; position: absolute">
                    @Model.insertMSG
                </div>
            </div>
        </form>
    </div>
    @* Delete part *@
    <form method="post" asp-page-handler="DeleteCourse">
        <div id="delete_input" style="@Model.delete_input"> 
            <label for="CourseToDelete">Choose a course to delete:</label>
            <select name="CourseToDelete" id="CourseTodelet" class="input_field">
                @foreach (var course in @Model.List)
                        {
                            <option value="@course.course.CId">
                        Course Name: @course.course.CourseName &nbsp&nbsp&nbsp&nbsp Course Number: @course.course.CourseNumber &nbsp&nbsp&nbsp&nbsp Teacher: @course.person.Name
                            </option>
                         }
            </select>
            
           
        </div>
        <div>
            <button type="submit" value="Delete" id="deleteButton" style="@Model.deleteButton" >
                Delete 
            </button>
            <div style="color: red; font-size: 1.0em; position: absolute">
                @Model.deleteMSG
            </div>
        </div>
    </form>
    <form method="post" asp-page-handler="Explain">
        <button type="submit" class="btn btn-primary">
            Explain with AI
        </button>
    </form>

</div>
