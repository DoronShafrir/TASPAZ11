@page


@using TASHPAV11.Model
@model TASHPAV11.Pages.Courses.ManageCoursesModel
@{   
}



<div class="container my-5">
    <div class="d-flex justify-content-between gap-3">
        <form method="get" asp-page-handler="RenderCourses">
            <button type="submit" value="Show All Courses" class="btn btn-primary">Show All Courses</button>
        </form>
        <form method="post" asp-page-handler="ShowAddCourses">
            <button type="submit" value="Add Course" class="btn btn-primary">Add Course</button>
        </form>
        <form method="post" asp-page-handler="ShowDeleteCourse">
            <button type="submit" value="Delete Course" class="btn btn-primary">Delete Course</button>
        </form>
        @* <form method="post" asp-page-handler="ShowAddCourses">
            <div id="List" style="@Model.DisplayList">@Html.Raw(@Model.List)</div>
        </form> *@
    </div>
</div>
@* <div class="row">
    <div id="List" style="@Model.DisplayList">@Html.Raw(@Model.List)</div>
</div> *@
<div id="CourseTable" style="@Model.DisplayList">


    @if (Model.List != null && Model.List.Count > 0)
    {
        <table class='table table-bordered table-striped'>
            <tr>
                <th>ID</th>
                <th>Course Name</th>
                <th>Course Number</th>
                <th>Teacher </th>

            </tr>

            @foreach (var course in Model.List)
            {
                <tr>
                    <td>@course.Course.CId</td>
                    <td>@course.Course.CourseName</td>
                    <td>@course.Course.CourseNumber</td>
                    <td>@course.Person.Name</td>
                </tr>
            }

        </table>
    }
</div>
<div class="button-container">
    <div class="row">
        @* Add Insert part *@
        <form method="post" asp-page-handler="InsertCourse">
            <div id="active_input" style="@Model.active_input">
                <input type="text" id="newCourseName" asp-for="newCourse.Course.CourseName" class="input_field" placeholder="Course Name" />
                <input type="number" id="newCourseNumber" asp-for="newCourse.Course.CourseNumber" class="input_field" placeholder="Course Number" />
                <input type="number" id="newCoursePererequisit" asp-for="newCourse.Course.Prerequisites_1" class="input_field" placeholder="Pererequisit 1" />
                <input type="number" id="newCourseCredit" asp-for="newCourse.Course.Credits" class="input_field" placeholder="Course Credit" />
                <input type="text" id="newCourseTeacher" asp-for="newCourse.Person.Name" class="input_field" placeholder="Teacher" />
                
                <label for="MathReq">Math Requirement</label>
                <input type="radio" id="MathReq" name="Department" class="input_field" value="MathReq" checked />
                <label for="ComputReq">Computer</label>
                <input type="radio" id="ComputReq" name="Department" class="input_field" value="ComputerReq" />
                <label for="Advance">Advance</label>
                <input type="radio" id="Advance" name="Department" class="input_field" value="Advance" />
               
                <button type="submit" value="Insert" id="submitNewButton" style="@Model.insert_button">
                    Insert
                </button>
                <div style="color: red; font-size: 1.0em; position: absolute">
                    @Model.insertMSG
                </div>
            </div>
        </form>
    </div>
    @* Delete part *@
    <form method="post" asp-page-handler="DeleteCourse">
        <div id="delete_input" style="@Model.delete_input">
            <input type="text" asp-for="dCourse.CourseName" class="input_field" placeholder="Course Name to Remove" />
            <input type="text" asp-for="dCourse.CourseNumber" class="input_field" placeholder="Course Number to Remove" />
            
        </div>
        <div>
            <input type="submit" value="Delete" id="deleteButton" style="@Model.deleteButton" />
            <div style="color: red; font-size: 1.0em; position: absolute">
                @Model.deleteMSG
            </div>
        </div>
    </form>
</div>